modules = ["nodejs-20", "web", "postgresql-16", "python-base-3.13"]
run = "DATABASE_URL=\"$NEON_DATABASE_URL\" npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5001
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_URL=\"$NEON_DATABASE_URL\" npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
mockupState = "FULLSTACK"
integrations = ["resend:1.0.0"]

[userenv]

[userenv.shared]
JWT_SECRET = "fasil-kenema-fc-secure-jwt-secret-key-2024-emperors"

[userenv.production]
APP_BASE_URL = "https://mechalfc.com"
